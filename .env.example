# CyberTraffic Pro — example environment
# Copy to .env and fill with your own endpoints. Never commit real .env.
#
# HTTPS endpoint that receives incident JSON via POST.
# Your backend forwards to police/authority systems.
VITE_POLICE_DISPATCH_URL=

# JSON feed describing latest APK version. Shape:
# { "latestVersion": "1.1.0", "latestBuild": 2, "downloadUrl": "https://.../app.apk", "notes": "..." }
VITE_UPDATE_FEED_URL=
